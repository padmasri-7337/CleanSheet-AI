# CleanSheet AI Root Environment Reference
# Copy this to backend/.env and frontend/.env as needed

# --- BACKEND (.env in backend/) ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cleansheet_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=cleansheet_ai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Limits & Retention
MAX_FILE_SIZE_BYTES=26214400
TEMP_STORAGE_TTL_SECONDS=7200

# --- FRONTEND (Optional frontend/.env) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
