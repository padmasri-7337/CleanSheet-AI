# CleanSheet AI Backend Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cleansheet_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=cleansheet_ai

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Limits (in bytes, default 25MB)
MAX_FILE_SIZE_BYTES=26214400

# Ephemeral File Storage TTL (in seconds, default 2 hours = 7200s)
TEMP_STORAGE_TTL_SECONDS=7200
